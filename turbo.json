{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": [".next/**", "!.next/cache/**", "dist/**"] },
    "dev": { "cache": false, "persistent": true },
    "test": { "cache": false, "outputs": ["coverage/**"] },
    "test:e2e": { "cache": false },
    "lint": {},
    "typecheck": {}
  }
}
