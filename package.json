{
  "name": "trend-pilot-ai",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "pnpm install && node -e \"const f=require('fs');if(!f.existsSync('.env.local'))f.copyFileSync('.env.example','.env.local')\"",
    "db:start": "supabase start --workdir packages/db",
    "db:reset": "supabase db reset --workdir packages/db && pnpm demo:load",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "build": "turbo run build",
    "demo:load": "pnpm --filter @tp/worker demo:load",
    "env:local": "node scripts/env-local.mjs",
    "i18n:check": "pnpm --filter @tp/web i18n:check",
    "demo:load:mock": "pnpm --filter @tp/worker demo:load --mock",
    "record": "pnpm --filter @tp/worker record",
    "record:check": "node scripts/check-fixtures.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "turbo": "2.11.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
