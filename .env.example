# Переменные окружения. Значения не коммитятся: копия в .env.local (pnpm run setup).
# Локально значения берутся из `supabase status` (ключи локального стенда).

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# Токены источников (только тестовые вне production, раздел 8.1). Без них live даёт «токен не настроен».
KASPI_API_TOKEN=
WB_API_TOKEN=
OZON_API_KEY=
ALIEXPRESS_APP_KEY=
ANALYTICS_API_KEY=

# Закупка на 1688/Taobao через провайдеров (packages/adapters/sourcing/README.md)
# PROVIDER: mock (по умолчанию, без сети) | onebound | apify
PROVIDER=
ONEBOUND_API_KEY=
ONEBOUND_API_SECRET=
APIFY_TOKEN=
# Необязательно: другой актор Apify вместо стандартного
APIFY_ACTOR_1688=
APIFY_ACTOR_TAOBAO=
# Кэш поиска, часов (по умолчанию 24; 0 — без кэша)
SOURCING_CACHE_TTL_HOURS=
# Ставки маржи для CLI sourcing: обязательны, значений по умолчанию нет
SOURCING_CNY_RUB=
SOURCING_SHIPPING_PER_UNIT_RUB=
SOURCING_WB_COMMISSION_PCT=
SOURCING_OTHER_COSTS_PER_UNIT_RUB=

# Демо-режим UI на синтетических данных (fixtures/demo), только local/preview
TP_DEMO_DATA=
