# Переменные окружения. Значения не коммитятся: копия в .env.local (pnpm run setup).
# Локально значения берутся из `supabase status` (ключи локального стенда).

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# Токены источников (только тестовые вне production, раздел 8.1). Без них live даёт «токен не настроен».
KASPI_API_TOKEN=
WB_API_TOKEN=
OZON_API_KEY=
ALIEXPRESS_APP_KEY=
ANALYTICS_API_KEY=

# Демо-режим UI на синтетических данных (fixtures/demo), только local/preview
TP_DEMO_DATA=
