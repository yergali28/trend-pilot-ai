{
  "name": "@tp/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "demo:load": "tsx src/demo-load.ts",
    "record": "node --env-file=.env.local --import tsx src/record.ts",
    "ingest:once": "node --env-file-if-exists=.env.local --import tsx src/ingest-once.ts",
    "schema:diff": "node --env-file=.env.local --import tsx src/schema-diff.ts",
    "refs:load": "node --env-file-if-exists=.env.local --import tsx src/refs-load.ts"
  },
  "dependencies": {
    "@tp/adapters": "workspace:*",
    "@tp/calc": "workspace:*",
    "@tp/db": "workspace:*",
    "pg": "8.23.1",
    "pg-boss": "12.38.0"
  },
  "devDependencies": {
    "tsx": "4.23.15"
  }
}
