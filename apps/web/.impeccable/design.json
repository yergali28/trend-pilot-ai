  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The single action-blue call to action.",
      "html": "<button class=\"ds-btn-primary\">Подобрать товары</button>",
      "css": ".ds-btn-primary { display:inline-flex; align-items:center; justify-content:center; gap:8px; height:36px; padding:0 16px; border-radius:6px; font-family:var(--tp-font-sans, \"Golos Text\"), ui-sans-serif, system-ui, sans-serif; font-size:0.875rem; line-height:1.375rem; font-weight:500; border:1px solid transparent; cursor:pointer; transition:background-color 150ms, color 150ms; background:var(--tp-action); color:var(--tp-action-text); } .ds-btn-primary:hover { background:var(--tp-action-hover); } .ds-btn-primary:focus-visible { outline: 2px solid var(--tp-focus); outline-offset: 2px; } .ds-btn-primary:disabled { opacity:.5; cursor:not-allowed; }"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Neutral action on a white surface with a strong hairline.",
      "html": "<button class=\"ds-btn-secondary\">Сохранить подборку</button>",
      "css": ".ds-btn-secondary { display:inline-flex; align-items:center; justify-content:center; gap:8px; height:36px; padding:0 16px; border-radius:6px; font-family:var(--tp-font-sans, \"Golos Text\"), ui-sans-serif, system-ui, sans-serif; font-size:0.875rem; line-height:1.375rem; font-weight:500; border:1px solid transparent; cursor:pointer; transition:background-color 150ms, color 150ms; background:var(--tp-surface); color:var(--tp-text); border-color:var(--tp-line-strong); } .ds-btn-secondary:hover { background:var(--tp-surface-sunken); } .ds-btn-secondary:focus-visible { outline: 2px solid var(--tp-focus); outline-offset: 2px; }"
    },
    {
      "name": "Ghost Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Low-emphasis text action; Blue Wash on hover.",
      "html": "<button class=\"ds-btn-ghost\">Сбросить фильтры</button>",
      "css": ".ds-btn-ghost { display:inline-flex; align-items:center; justify-content:center; gap:8px; height:36px; padding:0 16px; border-radius:6px; font-family:var(--tp-font-sans, \"Golos Text\"), ui-sans-serif, system-ui, sans-serif; font-size:0.875rem; line-height:1.375rem; font-weight:500; border:1px solid transparent; cursor:pointer; transition:background-color 150ms, color 150ms; background:transparent; color:var(--tp-action-soft-text); } .ds-btn-ghost:hover { background:var(--tp-action-soft); } .ds-btn-ghost:focus-visible { outline: 2px solid var(--tp-focus); outline-offset: 2px; }"
    },
    {
      "name": "Money Field",
      "kind": "input",
      "refersTo": "input-text",
      "description": "Labeled field with hint and a right-aligned tabular value plus currency suffix.",
      "html": "<div class=\"ds-field\"><label class=\"ds-field-label\" for=\"ds-budget\">Бюджет закупки</label><div class=\"ds-field-wrap\"><input id=\"ds-budget\" class=\"ds-input\" value=\"1 500 000\" inputmode=\"numeric\"><span class=\"ds-field-suffix\">₸</span></div><p class=\"ds-field-hint\">Сумма на одну партию</p></div>",
      "css": ".ds-field { display:flex; flex-direction:column; gap:6px; font-family:var(--tp-font-sans, \"Golos Text\"), ui-sans-serif, system-ui, sans-serif; } .ds-field-label { font-size:0.8125rem; line-height:1.25rem; font-weight:500; color:var(--tp-text); } .ds-field-wrap { position:relative; } .ds-input { width:100%; height:36px; padding:0 40px 0 12px; border:1px solid var(--tp-line-strong); border-radius:6px; background:var(--tp-surface); color:var(--tp-text); font:inherit; font-size:0.875rem; text-align:right; font-variant-numeric:tabular-nums; } .ds-input:focus-visible { outline: 2px solid var(--tp-focus); outline-offset: 2px; } .ds-input:disabled { background:var(--tp-surface-sunken); color:var(--tp-text-subtle); } .ds-field-suffix { position:absolute; top:0; bottom:0; right:12px; display:flex; align-items:center; font-size:0.875rem; color:var(--tp-text-subtle); pointer-events:none; } .ds-field-hint { margin:0; font-size:0.8125rem; line-height:1.25rem; color:var(--tp-text-subtle); }"
    },
    {
      "name": "Marketplace Chips",
      "kind": "chip",
      "refersTo": "chip-marketplace",
      "description": "Multi-select with an All chip; offline sources stay visible, dashed, with a reason.",
      "html": "<div class=\"ds-chips\"><label class=\"ds-chip ds-chip-on\"><span class=\"ds-box ds-box-on\"><svg width=\"12\" height=\"12\" viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3.5 8.5l3 3 6-7\"/></svg></span>Kaspi</label><label class=\"ds-chip\"><span class=\"ds-box\"></span>Ozon</label><label class=\"ds-chip ds-chip-off\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M6 2.5v2.5M10 2.5v2.5M4.5 5h7v2.5a3.5 3.5 0 01-7 0V5zM8 11v2.5M2.5 2.5l11 11\"/></svg>Wildberries <span class=\"ds-chip-reason\">· нет токена</span></label></div>",
      "css": ".ds-chips { display:flex; flex-wrap:wrap; gap:8px; font-family:var(--tp-font-sans, \"Golos Text\"), ui-sans-serif, system-ui, sans-serif; } .ds-chip { display:flex; align-items:center; gap:8px; height:36px; padding:0 12px; border:1px solid var(--tp-line-strong); border-radius:6px; background:var(--tp-surface); color:var(--tp-text); font-size:0.875rem; cursor:pointer; } .ds-chip:hover { background:var(--tp-surface-sunken); } .ds-chip:focus-within { outline:2px solid var(--tp-focus); outline-offset:2px; } .ds-chip-on, .ds-chip-on:hover { border-color:var(--tp-action); background:var(--tp-action-soft); color:var(--tp-action-soft-text); } .ds-chip-off, .ds-chip-off:hover { border-style:dashed; background:var(--tp-offline-soft); color:var(--tp-offline); cursor:not-allowed; } .ds-chip-reason { font-size:0.8125rem; } .ds-box { display:flex; align-items:center; justify-content:center; width:16px; height:16px; border:1px solid var(--tp-line-strong); border-radius:4px; } .ds-box-on { border-color:var(--tp-action); background:var(--tp-action); color:var(--tp-action-text); }"
    },
    {
      "name": "Section Nav",
      "kind": "nav",
      "refersTo": "nav-item",
      "description": "Sticky white nav bar; current item in Blue Wash.",
      "html": "<nav class=\"ds-nav\"><a class=\"ds-nav-item\" href=\"#\" aria-current=\"location\">Палитра</a><a class=\"ds-nav-item\" href=\"#\">Типографика</a><a class=\"ds-nav-item\" href=\"#\">Таблица</a></nav>",
      "css": ".ds-nav { display:flex; gap:4px; padding:8px; background:var(--tp-surface); border-bottom:1px solid var(--tp-line); font-family:var(--tp-font-sans, \"Golos Text\"), ui-sans-serif, system-ui, sans-serif; font-size:0.8125rem; } .ds-nav-item { padding:6px 10px; border-radius:6px; color:var(--tp-text-muted); text-decoration:none; } .ds-nav-item:hover { background:var(--tp-surface-sunken); color:var(--tp-text); } .ds-nav-item:focus-visible { outline: 2px solid var(--tp-focus); outline-offset: 2px; } .ds-nav-item[aria-current] { background:var(--tp-action-soft); color:var(--tp-action-soft-text); font-weight:500; }"
    },
    {
      "name": "Multiple Badges",
      "kind": "custom",
      "refersTo": "badge-multiple-x5",
      "description": "Green multiple scale from below-2x to 10x; value always printed; missing value is the no-data word.",
      "html": "<div class=\"ds-badges\"><span class=\"ds-mx ds-mx-below\">1,7x</span><span class=\"ds-mx ds-mx-2\">2,4x</span><span class=\"ds-mx ds-mx-3\">3,6x</span><span class=\"ds-mx ds-mx-5\">5,6x</span><span class=\"ds-mx ds-mx-10\">10,7x</span><span class=\"ds-nodata\">нет данных</span></div>",
      "css": ".ds-badges { display:flex; flex-wrap:wrap; gap:8px; align-items:center; font-family:var(--tp-font-sans, \"Golos Text\"), ui-sans-serif, system-ui, sans-serif; } .ds-mx { display:inline-flex; justify-content:center; min-width:48px; padding:2px 6px; border-radius:6px; font-size:0.8125rem; line-height:1.25rem; font-weight:600; font-variant-numeric:tabular-nums; } .ds-mx-below { background:var(--tp-x-below-bg); color:var(--tp-x-below-text); } .ds-mx-2 { background:var(--tp-x2-bg); color:var(--tp-x2-text); } .ds-mx-3 { background:var(--tp-x3-bg); color:var(--tp-x3-text); } .ds-mx-5 { background:var(--tp-x5-bg); color:var(--tp-x5-text); } .ds-mx-10 { background:var(--tp-x10-bg); color:var(--tp-x10-text); } .ds-nodata { color:var(--tp-nodata); border-bottom:1px dashed var(--tp-nodata-line); font-size:0.875rem; }"
    },
    {
      "name": "Status Tags",
      "kind": "chip",
      "refersTo": "status-tag-risk",
      "description": "Icon + word on the soft tint of its tone; color only repeats the meaning.",
      "html": "<div class=\"ds-tags\"><span class=\"ds-tag ds-tag-risk\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\"><circle cx=\"8\" cy=\"8\" r=\"6\"/><path d=\"M5.75 5.75l4.5 4.5M10.25 5.75l-4.5 4.5\"/></svg>Убыток</span><span class=\"ds-tag ds-tag-warning\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M8 2.5l6 10.5H2L8 2.5z\"/><path d=\"M8 6.5v3M8 11.25v.01\"/></svg>Мало продаж</span><span class=\"ds-tag ds-tag-nodata\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\"><path d=\"M4 8h8\"/></svg>Нет данных</span></div>",
      "css": ".ds-tags { display:flex; flex-wrap:wrap; gap:8px; font-family:var(--tp-font-sans, \"Golos Text\"), ui-sans-serif, system-ui, sans-serif; } .ds-tag { display:inline-flex; align-items:center; gap:4px; padding:2px 6px; border-radius:6px; font-size:0.8125rem; line-height:1.25rem; font-weight:500; } .ds-tag-risk { background:var(--tp-risk-soft); color:var(--tp-risk); } .ds-tag-warning { background:var(--tp-warning-soft); color:var(--tp-warning); } .ds-tag-nodata { background:var(--tp-nodata-soft); color:var(--tp-nodata); }"
    },
    {
      "name": "Comparison Table",
      "kind": "card",
      "refersTo": "table-cell",
      "description": "Panel-framed table; muted headers, right-aligned tabular figures, loss in risk with icon.",
      "html": "<div class=\"ds-table-wrap\"><table class=\"ds-table\"><thead><tr><th>Товар</th><th class=\"ds-num\">Себестоимость</th><th class=\"ds-num\">Прибыль</th></tr></thead><tbody><tr><td>Термокружка 500 мл</td><td class=\"ds-num\">2 140 ₸</td><td class=\"ds-num\">1 380 ₸</td></tr><tr><td>Органайзер для проводов</td><td class=\"ds-num\">1 760 ₸</td><td class=\"ds-num ds-loss\">−449 ₸</td></tr></tbody></table></div>",
      "css": ".ds-table-wrap { overflow-x:auto; border:1px solid var(--tp-line); border-radius:8px; background:var(--tp-surface); font-family:var(--tp-font-sans, \"Golos Text\"), ui-sans-serif, system-ui, sans-serif; } .ds-table { width:100%; border-collapse:collapse; font-size:0.875rem; line-height:1.375rem; color:var(--tp-text); } .ds-table th { padding:10px 12px; text-align:left; font-size:0.8125rem; font-weight:500; color:var(--tp-text-muted); border-bottom:1px solid var(--tp-line); white-space:nowrap; } .ds-table td { padding:10px 12px; border-bottom:1px solid var(--tp-line); white-space:nowrap; font-variant-numeric:tabular-nums; } .ds-table tr:last-child td { border-bottom:0; } .ds-table tbody tr:hover { background:var(--tp-surface-sunken); } .ds-table .ds-num { text-align:right; } .ds-loss { color:var(--tp-risk); font-weight:500; }"
    }
  ],
  "narrative": {
    "northStar": "The Honest Ledger",
    "overview": "**Creative North Star: \"The Honest Ledger\"**\n\nA working analytics screen for marketplace sellers in the category standard, finished to the level of Stripe Dashboard and MPStats. The figure is the protagonist: tabular digits, right-aligned to the place value, currency beside the number, and an explicit word where a value is missing. Everything else steps back: a cool light-grey page, white surfaces, hairlines instead of shadows, one blue for action.\n\nColor is semantic, never decorative. There are exactly three colored vocabularies: action (blue), the multiple scale 2x to 10x (green, deepening with value), and status (risk red, warning amber, no-data grey with a dashed underline, source-offline grey with an unplug icon). Every colored state is duplicated by a word or a shape. Light theme is the default; dark is the second theme, set by `data-theme=\"dark\"` on the page wrapper (which also darkens the document root via `:has`).\n\nDensity is moderate and even: 36px controls, 14px body, 4px spacing step, compact inside a group and generous between groups. Motion is functional only (the loading spinner, color transitions of 150ms), and respects `prefers-reduced-motion`.",
    "keyCharacteristics": [
      "Numbers read first: `tabular-nums` everywhere a figure appears, right-aligned in tables.",
      "One action blue; data visualization stays neutral grey unless it carries profit or loss.",
      "Flat surfaces separated by 1px lines and tonal steps; shadow reserved for floating layers.",
      "Status by color + icon/shape + word; \"no data\" is a word, never a number.",
      "Golos Text across all roles, Cyrillic-first with Kazakh coverage."
    ],
    "rules": [
      {
        "name": "The One Blue Rule",
        "body": "Blue means \"you can act here\" (button, link, focus, selected filter). Data, charts and badges never use it.",
        "section": "colors"
      },
      {
        "name": "The Said-Twice Rule",
        "body": "No state is carried by color alone: risk has a crossed circle, warning a triangle, no-data a dashed underline and the word, offline an unplug icon and a reason, ok a filled dot, multiple a printed value.",
        "section": "colors"
      },
      {
        "name": "The Honest Gap Rule",
        "body": "A missing value renders the localized \"no data\" word in `nodata` with a dashed `nodata-line` underline. Never a zero, dash or average in its place. Estimated values carry a leading \"≈\".",
        "section": "colors"
      },
      {
        "name": "The Tabular Rule",
        "body": "Every figure uses `tabular-nums`; table number columns align right; currency and unit sit beside the value (`10 000 ₸`, `3,6x`), formatted per locale with `Intl.NumberFormat` and the narrow currency symbol.",
        "section": "typography"
      },
      {
        "name": "The Lines-Not-Shadows Rule",
        "body": "Separation is a hairline or a tonal step. A shadow appears only on a layer that floats above the page.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** take every value from the `--tp-*` variables in `packages/ui/tokens.css` (or their Tailwind aliases); never hard-code a hex in a component.",
      "**Do** render figures with `tabular-nums`, right-aligned in tables, with the unit or narrow currency symbol beside the value.",
      "**Do** pair every status color with its icon or shape and a word.",
      "**Do** show an unavailable source greyed with its reason instead of hiding it.",
      "**Do** keep controls at 36px (44px on coarse pointers) and use the 2px `focus` outline at 2px offset for keyboard focus."
    ],
    "donts": [
      "**Don't** use blue for data, charts or badges; it belongs to action.",
      "**Don't** put a number, zero or average where data is missing; use the no-data word.",
      "**Don't** add shadows to resting panels or cards; separate with a hairline or tonal step.",
      "**Don't** use gradients, emoji in place of icons, or decorative animation.",
      "**Don't** nest panels inside panels."
    ]
  }
}