        "name": "overlay",
        "value": "0 8px 24px rgb(17 23 34 / 0.12), 0 1px 3px rgb(17 23 34 / 0.08)",
        "purpose": "Floating layers only (popover, menu, dialog). Defined, no shipped consumer yet."
      },
      {
        "name": "overlay-dark",
