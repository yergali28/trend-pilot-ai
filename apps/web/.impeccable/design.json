      "figure": {
        "displayName": "Figure",
        "purpose": "Key figures in cards and scenario ranges, tabular."
      },
      "body": {
        "displayName": "Body",
        "purpose": "Running text, table cells, field values."
      },
      "label": {
        "displayName": "Label",
        "purpose": "Field labels, column headers, hints, captions, badges, nav."
      }
